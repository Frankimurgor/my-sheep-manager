{
  "expo": {
    "name": "My Sheep Manager",
    "slug": "my-sheep-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mysheepmanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E5D3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumolabs.mysheepmanager",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1F3D28"
      },
      "package": "com.lumolabs.mysheepmanager",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "My Sheep Manager needs access to your photos to attach images to sheep profiles.",
          "cameraPermission": "My Sheep Manager needs camera access to photograph sheep for their profiles."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "52d84aec-4c17-4a6c-b81f-195ad3db8079"
      },
      "router": {}
    }
  }
}
